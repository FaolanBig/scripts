# Copy to docker-worker.env and edit the database URL.
# Use the master machine's reachable IP or DNS name instead of "db".
DATABASE_URL=postgres://postgres:<password>@windmill-master.example.com:5432/windmill?sslmode=disable

WM_IMAGE=ghcr.io/windmill-labs/windmill:1.883.0
DIND_IMAGE=docker:27-dind

# The worker group and tag used by Docker-test flows.
DOCKER_WORKER_GROUP=docker-test
DOCKER_WORKER_TAGS=docker-test

KEEP_JOB_DIR=false
FAVOR_UNSHARE_PID=false
LOG_MAX_SIZE=20m
LOG_MAX_FILE=10
