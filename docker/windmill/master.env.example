# Copy to master.env and edit before starting the master stack.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=windmill
WM_IMAGE=ghcr.io/windmill-labs/windmill:1.883.0
WM_EXTRA_IMAGE=ghcr.io/windmill-labs/windmill-extra:1.883.0
LOG_MAX_SIZE=20m
LOG_MAX_FILE=10
