# Copy to worker.env on every worker machine and edit the database URL.
# Use the master machine's reachable IP or DNS name instead of "db".
DATABASE_URL=postgres://postgres:replace-with-the-master-postgres-password@windmill-master.example.com:5432/windmill?sslmode=disable
WM_IMAGE=ghcr.io/windmill-labs/windmill:main
WORKER_GROUP=default
KEEP_JOB_DIR=false
NATIVE_SLEEP_QUEUE=200
LOG_MAX_SIZE=20m
LOG_MAX_FILE=10
